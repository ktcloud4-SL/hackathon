APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Database Configuration (PostgreSQL Asyncpg)
# Local: postgresql+asyncpg://onereport:onereport@localhost:5432/onereport
# AWS RDS: postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
DATABASE_URL=postgresql+asyncpg://onereport:onereport@localhost:5432/onereport


# Provisioning and IAM Role binding are provided by the infrastructure team.
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PREFIX=reports
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# Configure after a public-data API is selected.
PUBLIC_DATA_BASE_URL=
PUBLIC_DATA_API_KEY=
