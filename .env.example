# Application Environment
APP_ENV=production

# Database Configuration (PostgreSQL Asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onereport
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/onereport

# JWT & Authentication Configuration (min 32 chars secret)
JWT_SECRET=onereport-super-secret-jwt-key-must-be-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_SECURE=false

# AWS S3 Storage (for report image uploads)
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=onereport-uploads-788246d2
STORAGE_BUCKET=onereport-uploads-788246d2
STORAGE_PREFIX=reports
